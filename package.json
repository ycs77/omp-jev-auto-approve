{
  "name": "omp-jev-auto-approve",
  "version": "0.1.2",
  "description": "Jev-powered approval for OMP commands, code execution, and file access",
  "keywords": [
    "ai",
    "ai-agent",
    "bash",
    "bash-approval",
    "command-approval",
    "command-review",
    "jev",
    "oh-my-pi",
    "oh-my-pi-plugin",
    "omp",
    "omp-extension",
    "tool-approval",
    "tool-permissions",
    "typesafe-ai"
  ],
  "homepage": "https://github.com/ycs77/omp-jev-auto-approve",
  "license": "MIT",
  "author": {
    "name": "Lucas Yang",
    "email": "yangchenshin77@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycs77/omp-jev-auto-approve.git"
  },
  "files": [
    "src/index.ts"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "bun lint && bun fmt --check && bun typecheck && bun test",
    "update-actions": "actionspack update",
    "release": "bumpp --commit \"Release v%s\""
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.0.0",
    "@types/bun": "^1.4.2",
    "actionspack": "^0.1.5",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
