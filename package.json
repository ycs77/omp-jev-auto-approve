    "bumpp": "^12.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
